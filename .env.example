# ──────────────────────────────────────────────
# RecruitIQ — Environment Variables
# Copy to .env and fill in real values
# ──────────────────────────────────────────────

# ─── PostgreSQL ───
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_use_a_strong_password
POSTGRES_DB=recruitiq_db

# ─── Backend ───
DATABASE_URL=postgresql://postgres:CHANGE_ME_use_a_strong_password@postgres:5432/recruitiq_db
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── LLM / AI ───
GEMINI_API_KEY=your-gemini-api-key-here
LLM_PROVIDER=gemini

# ─── CORS ───
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Supabase Storage (optional, falls back to local) ───
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=resumes
